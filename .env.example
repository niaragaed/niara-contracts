# Copy to .env and fill in locally. .env is in .gitignore; check with `git status` before
# any commit.
#
# NO SECRET GOES IN THIS FILE. There is no PRIVATE_KEY and no mnemonic here, and the scripts
# never read one. Every signer is a Foundry keystore (encrypted, outside the repository, in
# ~/.foundry/keystores), named on the command line with --account. This file only holds
# public values: RPC endpoints, an explorer API key, addresses and parameters.
#
# Deployment is restricted to two testnets: Ethereum Sepolia (11155111) and Base Sepolia
# (84532). The scripts revert on any other chain. Never mainnet.

# ── Networks ────────────────────────────────────────────────────────────────────────
# RPC endpoints, referenced by name: --rpc-url sepolia / --rpc-url base_sepolia.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Explorer API key for contract verification (--verify). One Etherscan key covers both
# chains (Etherscan API v2).
ETHERSCAN_API_KEY=

# ── Signers, by ADDRESS (script/Deploy.s.sol) ───────────────────────────────────────
# Address of the dedicated deployer keystore (`cast wallet address --account
# niara-evm-deployer`). It signs both deployment phases and becomes the admin of every
# contract (DEFAULT_ADMIN_ROLE, PAUSER_ROLE, TREASURY_ROLE). Required.
DEPLOYER_ADDRESS=

# Optional, both default to DEPLOYER_ADDRESS. Set them to run with distinct role wallets
# (script/Demo.s.sol requires that); each one then needs its own keystore.
# LISTING_AUTHORITY_ROLE on the registry: approves listings and issuance batches.
LISTING_AUTHORITY_ADDRESS=
# SETTLEMENT_OPERATOR_ROLE on NiaraSettlement: the only caller of `settle`.
OPERATOR_ADDRESS=

# ── Demo wallets, by ADDRESS (script/Demo.s.sol) ────────────────────────────────────
# The demo needs SIX DISTINCT wallets and refuses to run otherwise: the three above
# (deployer, listing authority, operator; so LISTING_AUTHORITY_ADDRESS and OPERATOR_ADDRESS
# must be set to their own wallets BEFORE deploy phase 1) plus these three. Each is a
# keystore; only its address goes here.
# The issuing company: creates the demo instruments and receives the cashback.
DEMO_ISSUER_ADDRESS=
# The two investors: A buys shares, sells bonds and sells mock BRL; B is the other side.
DEMO_INVESTOR_A_ADDRESS=
DEMO_INVESTOR_B_ADDRESS=

# Test ETH each of the five role wallets is topped up to by the deployer before the demo,
# so they can pay their own gas. 0 = do not top up (fund them yourself).
DEMO_GAS_FUNDING_WEI=20000000000000000

# ── Parameters (script/Deploy.s.sol) ────────────────────────────────────────────────
# Timelock delay in seconds for every contract. Minimum allowed by the contracts: 3600
# (1 hour). It cannot be lowered, not even on testnet.
TIMELOCK_DELAY=3600

# Cashback share of the fee, in bps (2000 = 20% of the fee, at most 10000). Phase 1 passes
# it to the CashbackDistributor's constructor, so it applies from the first block; phase 2
# and verify() only check that the deployed rate is still this value. Changing it after
# deployment goes through the contract's timelock, not through this variable. The fee
# itself is not configurable here: it is 50 bps, the contract's default and its hard cap.
CASHBACK_BPS=2000

# ── Filled in from the output of deploy PHASE 1, one set per chain ───────────────────
# The suffix is the chain id, so a script can never use the other chain's addresses.
# Required by `executeWiring()`, `verify()` and script/Demo.s.sol. The other addresses
# (registry, factory, distributor, mock USDT) are read from these contracts.
DEPLOYED_SETTLEMENT_ADDRESS_11155111=
DEPLOYED_ESCROW_ADDRESS_11155111=
DEPLOYED_MOCK_BRL_ADDRESS_11155111=

DEPLOYED_SETTLEMENT_ADDRESS_84532=
DEPLOYED_ESCROW_ADDRESS_84532=
DEPLOYED_MOCK_BRL_ADDRESS_84532=
