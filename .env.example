# Copy to .env and fill in locally. NEVER commit .env or real private keys.
# .env is already in .gitignore; check with `git status` before any commit.
# ALWAYS use a throwaway wallet created only for testnet, with no real value.
# Deployment at this stage is restricted to testnet (Sepolia): never mainnet without an explicit request.

# RPC of a test network (e.g. Sepolia). Do not use mainnet at this stage.
RPC_URL=

# Private key of a TEST account with no real funds. Never the key of a real account.
PRIVATE_KEY=

# API key for contract verification on a block explorer (e.g. Etherscan).
ETHERSCAN_API_KEY=

# ── Deploy roles (script/Deploy.s.sol) ──────────────────────────────────────────────
# All optional: if empty, the PRIVATE_KEY address takes every role
# (deployer = admin = operator = custodian = issuer), which is enough to run
# script/Demo.s.sol without any other private key.

# Holder of DEFAULT_ADMIN_ROLE/PAUSER_ROLE in the four contracts (recommended: a multisig
# in production; a throwaway wallet is enough on testnet).
ADMIN_ADDRESS=

# Holder of OPERATOR_ROLE (BackingGateway) and SETTLEMENT_OPERATOR_ROLE (NiaraSettlement).
OPERATOR_ADDRESS=

# Holder of CUSTODIAN_ROLE (BackingGateway).
CUSTODIAN_ADDRESS=

# Issuer wallet of the demo AssetToken (receives the cashback). If it differs from
# PRIVATE_KEY, the `withdraw` step of script/Demo.s.sol will not work: that
# script only signs transactions with the deployer key.
ISSUER_WALLET_ADDRESS=

# Timelock delay in seconds for the deployed contracts. Minimum allowed by the
# contract: 3600 (1 hour). It cannot be lowered, not even on testnet.
TIMELOCK_DELAY=3600

# ── Demo AssetToken metadata (script/Deploy.s.sol) ──────────────────────────────────
ASSET_NAME=Niara Demo Equity
ASSET_SYMBOL=nDEMO
ASSET_REFERENCE=DEMO
ASSET_COUNTRY=US

# ── Demo flow parameters (script/Demo.s.sol) ────────────────────────────────────────
DEMO_BACKING_QUANTITY=1000000000000000000000
DEMO_SETTLE_ASSET_AMOUNT=100000000000000000000
DEMO_SETTLE_PAYMENT_AMOUNT=10000000000
DEMO_BUYER_GAS_FUNDING_WEI=10000000000000000

# ── Filled in by deploy PHASE 1 (copy the output of `forge script Deploy.s.sol`) ─────
# Required by script/Deploy.s.sol --sig "executeWiring()" (phase 2) and by
# script/Demo.s.sol.
DEPLOYED_USDT_ADDRESS=
DEPLOYED_WBTC_ADDRESS=
DEPLOYED_DISTRIBUTOR_ADDRESS=
DEPLOYED_SETTLEMENT_ADDRESS=
DEPLOYED_GATEWAY_ADDRESS=
DEPLOYED_ASSET_TOKEN_ADDRESS=
